{
  "name": "guldheden-interactive-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "party": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:party": "wrangler deploy",
    "smoke": "node scripts/smoke-test.mjs protocol",
    "smoke:prod": "node scripts/smoke-test.mjs protocol --server guldheden-archive.william-av-holmberg.workers.dev",
    "bot:prod": "node scripts/smoke-test.mjs bot --server guldheden-archive.william-av-holmberg.workers.dev --room bot-test",
    "deploy:site": "npx vercel deploy --prod --yes",
    "deploy": "npm run deploy:party && npm run smoke:prod && npm run deploy:site"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^5.4.21",
    "wrangler": "^4.137.0"
  }
}